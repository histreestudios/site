<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Histree Email Generator</title>
<style>
  :root{
    --ink:#1b1b18; --paper:#f6f3ec; --line:#dcd5c4;
    --moss:#3f4f3a; --moss-dark:#2b3527; --clay:#a9552f;
    --muted:#7a7466; --card:#ffffff;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:'Iowan Old Style','Georgia',serif;line-height:1.5;}
  .wrap{max-width:1000px;margin:0 auto;padding:34px 24px 80px;}
  header{border-bottom:2px solid var(--ink);padding-bottom:16px;margin-bottom:22px;}
  header h1{font-size:25px;margin:0 0 4px;}
  header p{margin:0;color:var(--muted);font-family:'Helvetica Neue',Arial,sans-serif;font-size:12.5px;letter-spacing:.4px;text-transform:uppercase;}

  .tabs{display:flex;gap:6px;margin-bottom:18px;}
  .tab{font-family:'Helvetica Neue',Arial,sans-serif;font-size:12.5px;letter-spacing:.3px;padding:9px 16px;border:1px solid var(--line);border-radius:5px;cursor:pointer;background:#fdfcf9;text-transform:uppercase;color:var(--muted);}
  .tab.active{background:var(--moss);color:#fff;border-color:var(--moss);}
  .section{display:none;} .section.active{display:block;}

  .grid{display:grid;grid-template-columns:380px 1fr;gap:22px;}
  @media (max-width:880px){.grid{grid-template-columns:1fr;}}

  .card{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:18px;margin-bottom:18px;}
  .card h2{font-family:'Helvetica Neue',Arial,sans-serif;font-size:11.5px;text-transform:uppercase;letter-spacing:1px;color:var(--moss-dark);margin:0 0 12px;border-bottom:1px solid var(--line);padding-bottom:8px;}
  label{display:block;font-family:'Helvetica Neue',Arial,sans-serif;font-size:11.5px;color:var(--muted);margin:10px 0 4px;}
  input,textarea,select{width:100%;padding:8px 9px;border:1px solid var(--line);border-radius:4px;font-family:'Helvetica Neue',Arial,sans-serif;font-size:13px;background:#fdfcf9;color:var(--ink);}
  textarea{resize:vertical;}
  #transcript{min-height:220px;}
  #fuOriginal{min-height:160px;}

  button{font-family:'Helvetica Neue',Arial,sans-serif;background:var(--moss);color:#fff;border:none;border-radius:4px;padding:11px 14px;font-size:13.5px;cursor:pointer;width:100%;margin-top:14px;}
  button:hover{background:var(--moss-dark);}
  button:disabled{background:#b8b2a2;cursor:wait;}

  .status{font-family:'Helvetica Neue',Arial,sans-serif;font-size:12px;color:var(--clay);min-height:16px;margin-top:6px;}
  .notice{background:#fbf3e6;border:1px solid #e6cf9f;border-radius:6px;padding:11px 13px;font-family:'Helvetica Neue',Arial,sans-serif;font-size:12px;color:#6b4f1d;margin-bottom:18px;}

  .toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;font-family:'Helvetica Neue',Arial,sans-serif;font-size:12px;color:var(--muted);}
  .toolbar button{width:auto;margin:0;padding:7px 12px;font-size:12px;background:var(--clay);}
  .toolbar button:hover{background:#8a441f;}

  .email-card{background:var(--card);border:1px solid var(--line);border-radius:6px;margin-bottom:12px;overflow:hidden;}
  .email-card.selected{border-color:var(--moss);box-shadow:0 0 0 1px var(--moss);}
  .email-head{display:flex;justify-content:space-between;align-items:center;background:#efe9da;padding:8px 13px;font-family:'Helvetica Neue',Arial,sans-serif;font-size:11px;letter-spacing:.4px;text-transform:uppercase;color:var(--moss-dark);}
  .email-head .left{display:flex;align-items:center;gap:8px;}
  .angle{background:var(--clay);color:#fff;padding:2px 7px;border-radius:3px;font-size:10px;text-transform:none;letter-spacing:0;}
  .email-body{padding:14px 16px;}
  .email-subject{font-weight:bold;font-size:14.5px;margin-bottom:7px;}
  .email-text{white-space:pre-wrap;font-size:14px;}
  .btnrow{display:flex;gap:6px;}
  .copy-btn,.select-btn{font-family:'Helvetica Neue',Arial,sans-serif;font-size:10.5px;background:transparent;border:1px solid var(--moss);color:var(--moss);padding:4px 8px;border-radius:3px;width:auto;margin:0;cursor:pointer;}
  .copy-btn:hover,.select-btn:hover{background:var(--moss);color:#fff;}
  .select-btn.active{background:var(--moss);color:#fff;}

  .empty{color:var(--muted);font-family:'Helvetica Neue',Arial,sans-serif;font-size:13px;padding:26px;text-align:center;border:1px dashed var(--line);border-radius:6px;}
  .snapshot{background:#f0f4ee;border:1px solid #cdd9c6;border-radius:6px;padding:12px 14px;font-family:'Helvetica Neue',Arial,sans-serif;font-size:12.5px;margin-bottom:16px;white-space:pre-wrap;}
</style>
</head>
<body>
<div class="wrap">

  <header>
    <h1>Histree Email Generator</h1>
    <p>Paste a transcript → get 20 personalized emails built off their actual content · paste a sent email → get the best follow-ups</p>
  </header>

  <div class="notice">
    No tool can promise 100% opens/replies — real benchmarks for a well-run sequence run roughly 40–60% opens and
    5–15% replies. This generator pushes toward that ceiling by grounding every email in something specific from the
    transcript instead of generic claims.
  </div>

  <div class="tabs">
    <div class="tab active" data-tab="gen">Generate 20 Emails</div>
    <div class="tab" data-tab="followup">Best Follow-Ups</div>
  </div>

  <!-- TAB 1 -->
  <div class="section active" id="gen">
    <div class="grid">
      <div>
        <div class="card">
          <h2>Prospect</h2>
          <label>First name</label>
          <input id="pName" placeholder="Marcus">
          <label>Channel / show name</label>
          <input id="pChannel" placeholder="The Growth Lab Podcast">
          <label>Anything else you know about them (optional)</label>
          <textarea id="pExtra" style="min-height:56px" placeholder="e.g. posts weekly, recently started a newsletter too"></textarea>
        </div>
        <div class="card">
          <h2>Video / episode transcript</h2>
          <label>Paste the transcript — this drives everything</label>
          <textarea id="transcript" placeholder="Paste the full or partial transcript of their latest video/episode here..."></textarea>
          <button id="genBtn">Generate 20 Best Emails</button>
          <div class="status" id="genStatus"></div>
        </div>
      </div>

      <div>
        <div id="snapshotOutput"></div>
        <div id="genOutput"><div class="empty">Paste a transcript and generate — the tool reads it for their specific topic, problem, and a hook it can quote, then writes 20 different personalized emails so you can pick your favorites.</div></div>
      </div>
    </div>
  </div>

  <!-- TAB 2 -->
  <div class="section" id="followup">
    <div class="grid">
      <div>
        <div class="card">
          <h2>Last email(s) sent</h2>
          <label>Paste the email (or thread) you already sent</label>
          <textarea id="fuOriginal" placeholder="Paste the exact email that already went out — include prior follow-ups too if there were any..."></textarea>
          <label>Days since last sent</label>
          <select id="fuDays"><option value="3">3 days</option><option value="5" selected>5 days</option><option value="7">7 days</option><option value="10">10+ days</option></select>
          <label>Anything new since? (optional — new post, reply, etc.)</label>
          <input id="fuNew" placeholder="e.g. they posted a new episode / partially replied once">
          <button id="genFuBtn">Generate Best Follow-Ups</button>
          <div class="status" id="fuStatus"></div>
        </div>
      </div>
      <div id="fuOutput"><div class="empty">Paste the last email sent — you'll get several follow-up options ranked from softest to most direct, based on how much time has passed.</div></div>
    </div>
  </div>

</div>

<script>
const tabs = document.querySelectorAll('.tab');
tabs.forEach(t=>t.addEventListener('click',()=>{
  tabs.forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  t.classList.add('active');
  document.getElementById(t.dataset.tab).classList.add('active');
}));

async function callClaude(systemPrompt, userPrompt){
  const res = await fetch("https://api.anthropic.com/v1/messages", {
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body: JSON.stringify({
      model:"claude-sonnet-4-6",
      max_tokens:8000,
      system: systemPrompt,
      messages:[{role:"user", content:userPrompt}]
    })
  });
  const data = await res.json();
  return data.content.filter(b=>b.type==="text").map(b=>b.text).join("\n");
}

function escapeHtml(s){ return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

function parseEmails(raw){
  const blocks = raw.split(/---EMAIL---/i).map(b=>b.trim()).filter(Boolean);
  return blocks.map(b=>{
    const subMatch = b.match(/SUBJECT:\s*(.+)/i);
    const angleMatch = b.match(/ANGLE:\s*(.+)/i);
    const bodyMatch = b.split(/BODY:/i)[1];
    return {
      subject: subMatch ? subMatch[1].trim() : "(no subject)",
      angle: angleMatch ? angleMatch[1].trim() : "",
      body: bodyMatch ? bodyMatch.trim() : b
    };
  });
}

function copyEmail(btn){
  const card = btn.closest('.email-card');
  const subj = card.querySelector('.email-subject').innerText;
  const body = card.querySelector('.email-text').innerText;
  navigator.clipboard.writeText("Subject: "+subj+"\n\n"+body);
  const old = btn.textContent; btn.textContent = "Copied!";
  setTimeout(()=>btn.textContent = old, 1200);
}
function toggleSelect(btn){
  btn.classList.toggle('active');
  btn.closest('.email-card').classList.toggle('selected');
  btn.textContent = btn.classList.contains('active') ? "Selected ✓" : "Select";
}
function copySelected(){
  const cards = document.querySelectorAll('.email-card.selected');
  if(cards.length === 0){ alert("No emails selected yet — click Select on the ones you want first."); return; }
  let out = "";
  cards.forEach((c,i)=>{
    const subj = c.querySelector('.email-subject').innerText;
    const body = c.querySelector('.email-text').innerText;
    out += `Email ${i+1}\nSubject: ${subj}\n\n${body}\n\n---\n\n`;
  });
  navigator.clipboard.writeText(out);
  alert(cards.length + " selected email(s) copied to clipboard.");
}

function renderEmailCard(e, i){
  return `<div class="email-card">
    <div class="email-head">
      <div class="left"><span>Email ${i+1}</span>${e.angle ? `<span class="angle">${escapeHtml(e.angle)}</span>` : ""}</div>
      <div class="btnrow">
        <button class="select-btn" onclick="toggleSelect(this)">Select</button>
        <button class="copy-btn" onclick="copyEmail(this)">Copy</button>
      </div>
    </div>
    <div class="email-body">
      <div class="email-subject">${escapeHtml(e.subject)}</div>
      <div class="email-text">${escapeHtml(e.body)}</div>
    </div>
  </div>`;
}

// TAB 1: Generate 20 emails from transcript
document.getElementById('genBtn').addEventListener('click', async ()=>{
  const btn = document.getElementById('genBtn');
  const status = document.getElementById('genStatus');
  const out = document.getElementById('genOutput');
  const snap = document.getElementById('snapshotOutput');
  const name = document.getElementById('pName').value || "there";
  const channel = document.getElementById('pChannel').value || "their channel";
  const extra = document.getElementById('pExtra').value;
  const transcript = document.getElementById('transcript').value;

  if(!transcript.trim()){ status.textContent = "Paste a transcript first."; return; }

  btn.disabled = true;
  status.textContent = "Reading transcript and writing 20 emails — this can take a minute...";
  out.innerHTML = ""; snap.innerHTML = "";

  const system = `You write cold outreach emails for Histree Studios, a podcast/YouTube video editing and repurposing agency, reaching out to podcast/content creators.

Step 1 — read the transcript given and identify (silently, do not output this separately unless asked): the core topic, one real problem/struggle/pain point the creator mentioned or implied, one quotable line, and one moment that could become a hook or better title.

Step 2 — write 20 DIFFERENT cold emails to this creator, each grounded in something specific and TRUE from the transcript (not invented facts about them as a person, only things clearly in the transcript or given context). Every email must:
- Reference something concrete from the transcript (a quote, a point they made, a problem they described) — never generic praise like "love your content."
- Lead with value or an observation before any ask — high give:ask ratio.
- Be plain text, no markdown, no images, no more than one plain-text link placeholder [LINK] and only in a minority of the 20 (most should have NO link, just "happy to send it over if you're interested").
- Stay under 100 words.
- Sign with "– Joe".
- Feel like a different real email, not a reworded duplicate — vary: opening line style, which part of the transcript it references, the specific ask/CTA (feedback / try the free tool / offer to send a sample edit / offer to run their content through the tool / just a compliment-free observation with no ask), and length within the limit.
- Subject lines must all be different from each other.

Output EXACTLY 20 emails in this format, nothing else before/after:
---EMAIL---
SUBJECT: <subject line>
ANGLE: <3-5 word description of this email's angle, e.g. "quotes their pain point" or "offers free sample edit">
BODY:
<email body>`;

  const user = `Prospect first name: ${name}
Channel: ${channel}
Additional context: ${extra || "none"}

Transcript:
"""
${transcript}
"""

Generate the 20 emails now.`;

  try{
    const raw = await callClaude(system, user);
    const emails = parseEmails(raw);
    if(emails.length === 0){
      out.innerHTML = `<div class="empty">Couldn't parse a response — try again, or shorten the transcript slightly.</div>`;
    } else {
      out.innerHTML = `
        <div class="toolbar">
          <span>${emails.length} emails generated — click Select on your favorites, then Copy Selected.</span>
          <button onclick="copySelected()">Copy Selected</button>
        </div>
      ` + emails.map((e,i)=>renderEmailCard(e,i)).join("");
    }
    status.textContent = "Done — " + emails.length + " emails generated.";
  }catch(err){
    status.textContent = "Error generating emails. Try again.";
    console.error(err);
  }
  btn.disabled = false;
});

// TAB 2: Follow-ups
document.getElementById('genFuBtn').addEventListener('click', async ()=>{
  const btn = document.getElementById('genFuBtn');
  const status = document.getElementById('fuStatus');
  const out = document.getElementById('fuOutput');
  const original = document.getElementById('fuOriginal').value;
  const days = document.getElementById('fuDays').value;
  const newInfo = document.getElementById('fuNew').value;

  if(!original.trim()){ status.textContent = "Paste the last email sent first."; return; }

  btn.disabled = true; status.textContent = "Generating follow-ups..."; out.innerHTML = "";

  const system = `You write short, high-quality cold-email follow-ups for Histree Studios.
Read the original email(s) given and infer its tone, what was offered, and how much time has passed.
Rules:
- Every follow-up is 2-4 sentences max, plain text, no links, no re-explaining the original pitch in full.
- Sign every version "– Joe".
- If "new info since" is given, reference it specifically and naturally. If not, do NOT invent new activity — use a patient, no-pressure angle instead.
- Generate 5 follow-up options, ordered from softest/shortest to most direct, so the best fit for the situation is easy to pick:
  1. One-line bump ("just making sure this didn't get buried")
  2. Soft value-add (one small extra nugget or observation)
  3. Curiosity-based check-in
  4. Direct but low-pressure ask
  5. Final, no-pressure close-the-loop note (last one they'll get)
Output exactly 5 in this format:
---EMAIL---
SUBJECT: <subject, can lightly reuse/tweak original>
ANGLE: <name of the style, e.g. "Soft value-add">
BODY:
<body>`;

  const user = `Original email / thread already sent:
"""
${original}
"""
Days since last sent: ${days}
New info since (optional): ${newInfo || "none"}

Generate the 5 follow-up options now.`;

  try{
    const raw = await callClaude(system, user);
    const emails = parseEmails(raw);
    out.innerHTML = emails.map((e,i)=>renderEmailCard(e,i)).join("");
    status.textContent = "Done.";
  }catch(err){
    status.textContent = "Error generating follow-ups. Try again.";
    console.error(err);
  }
  btn.disabled = false;
});
</script>
</body>
</html>
